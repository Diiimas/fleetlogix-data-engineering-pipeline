# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fleetlogix
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_password

# Snowflake
SNOWFLAKE_USER=replace_with_your_user
SNOWFLAKE_PASSWORD=replace_with_your_password
SNOWFLAKE_ACCOUNT=replace_with_your_account
SNOWFLAKE_WAREHOUSE=FLEETLOGIX_WH
SNOWFLAKE_DATABASE=FLEETLOGIX_DW
SNOWFLAKE_SCHEMA=ANALYTICS
SNOWFLAKE_ROLE=replace_with_your_role

# Execution mode
# true: ejecuta extracción y transformación local sin cargar a Snowflake
# false: ejecuta el pipeline completo, incluida la carga a Snowflake
LOCAL_TEST_MODE=true